{
  "name": "blissful-backend",
  "version": "1.0.0",
  "description": "Express + MongoDB backend for the Blissful skincare e-commerce app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeder.js",
    "seed:destroy": "node seeder.js --destroy",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@sfpy/node-core": "^0.3.5",
    "axios": "^1.15.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.2"
  },
  "overrides": {
    "qs": "^6.17.1"
  }
}
